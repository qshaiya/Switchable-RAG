# Copy this file to .env and fill in what you need:  cp .env.example .env
# .env is gitignored — your real keys never get committed.

# Which providers to use (overrides config.yaml).
LLM_PROVIDER=openai            # openai (OpenAI-compatible) | anthropic | ollama
EMBEDDING_PROVIDER=ollama      # ollama (local, no key) | openai | jina | gemini

# --- Chat via OpenRouter (Mode A) -------------------------------------------
# Get a key at openrouter.ai. base_url points the OpenAI client at OpenRouter.
OPENAI_API_KEY=sk-or-...
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# To use OpenAI directly instead: use your sk-... key and DELETE the
# OPENAI_BASE_URL line (empty = OpenAI's default endpoint).

# --- Anthropic (optional) ---------------------------------------------------
ANTHROPIC_API_KEY=

# --- Jina hosted embeddings (for cloud deploy — no local GPU on Cloud Run) ---
# Free key (1M tokens, no card) at https://jina.ai/embeddings
# Set EMBEDDING_PROVIDER=jina above and embedding.model: jina-embeddings-v3 in config.yaml.
JINA_API_KEY=

# --- Google Gemini hosted embeddings (AI Studio free tier, no billing setup) -
# Free key at https://aistudio.google.com/apikey
# Set EMBEDDING_PROVIDER=gemini and embedding.model: gemini-embedding-001
GEMINI_API_KEY=

# --- Local Ollama (used here for embeddings; also for fully-local mode) ------
OLLAMA_BASE_URL=http://localhost:11434

# --- Vector store: local Chroma (default) or hosted Qdrant --------------------
# Set VECTOR_STORE=qdrant and fill these to use a managed Qdrant Cloud cluster.
# Free cluster + credentials at https://cloud.qdrant.io  (no card required)
VECTOR_STORE=chroma            # chroma | qdrant
QDRANT_URL=
QDRANT_API_KEY=

# --- Chat history (optional, MongoDB Atlas free tier) ------------------------
# Free cluster at https://www.mongodb.com/cloud/atlas ; leave unset to disable.
MONGODB_URI=
MONGODB_DB=rag_assistant
