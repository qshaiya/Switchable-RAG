# Copy this file to .env and fill in what you need:  cp .env.example .env
# .env is gitignored — your real keys never get committed.

# Which providers to use (overrides config.yaml). Leave as-is for hosted mode.
LLM_PROVIDER=openai            # openai | anthropic | ollama
EMBEDDING_PROVIDER=openai      # openai | ollama

# --- Hosted mode: fill the key for the provider you chose above --------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Local mode (Ollama): no key needed. Just set the providers to "ollama"
#     above and make sure Ollama is running. -------------------------------
OLLAMA_BASE_URL=http://localhost:11434

# --- Google Gemini hosted embeddings (AI Studio free tier) ---
# Free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Jina hosted embeddings (alternative) ---
# Free key at https://jina.ai/embeddings
JINA_API_KEY=

# --- Vector store: local Chroma (default) or hosted Qdrant ---
# Set VECTOR_STORE=qdrant and fill these for Qdrant Cloud (https://cloud.qdrant.io)
VECTOR_STORE=chroma            # chroma | qdrant
QDRANT_URL=
QDRANT_API_KEY=
